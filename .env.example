# Copy this file to .env.local and fill in values from the Supabase project:
#   Project Settings → API
#
# VITE_SUPABASE_URL        Project URL  (https://xxxxxxxx.supabase.co)
# VITE_SUPABASE_ANON_KEY   anon / public key
#
# Then run supabase/schema.sql in the SQL editor (PostgreSQL).
# Restart `npm run dev` after saving .env.local so Vite picks up the vars.
#
# Leave both blank to stay in local mode (localStorage only, no network).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
